# Copy to .env and fill in. .env is git-ignored; this example file is committed.
# Values: https://mcp-hackathon.sherpaswealth.com/personal-token ("For your backend")

# Case data (MCP). The token is personal and expires 72 hours after login.
MCP_URL=https://mcp-hackathon.sherpaswealth.com/mcp
MCP_TOKEN=your-personal-mcp-token

# AI models (OpenAI-compatible proxy). Team key, shared $50 budget.
LLM_PROXY_URL=https://llm-hackathon.sherpaswealth.com
TEAM_KEY=your-team-ai-key
