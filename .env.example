# Copy to .env and fill in. .env is git-ignored; this example file is committed.
# Values: https://mcp-hackathon.sherpaswealth.com/personal-token ("For your backend")

# Case data (MCP). The token is personal and expires 72 hours after login.
MCP_URL=https://mcp-hackathon.sherpaswealth.com/mcp
MCP_TOKEN=your-personal-mcp-token

# AI models (OpenAI-compatible proxy). Team key, shared $50 budget.
LLM_PROXY_URL=https://llm-hackathon.sherpaswealth.com
TEAM_KEY=your-team-ai-key

# WhatsApp sending (web app -> server -> bot outbox).
# With `npm run serve` the bot runs next to the server: OUTBOX_URL and OUTBOX_SECRET are set automatically.
# Only set them when the bot runs on another machine (OUTBOX_SECRET: any long random string, identical on both).
# OUTBOX_URL=http://127.0.0.1:8788
# OUTBOX_SECRET=change-me-to-a-long-random-string
# Demo recipient: the families are fictional, so messages go only to the team's own test phone.
WHATSAPP_DEMO_TO=34600111222

# Public app (npm run serve): password everyone must enter. Required by npm run serve.
APP_PASSWORD=choose-a-team-password
# Optional: where the bot keeps its WhatsApp login, audio and chat links (default: apps/whatsapp-bot)
# BOT_DATA_DIR=/data/whatsapp-bot
