# Server-owned credentials from the Sherpas hackathon access page
TEAM_KEY=your-sherpas-team-ai-key
MCP_TOKEN=your-personal-sherpas-mcp-token
LLM_PROXY_URL=https://llm-hackathon.sherpaswealth.com/v1
MCP_URL=https://mcp-hackathon.sherpaswealth.com/mcp

# Generate a separate secret with at least 32 characters.
API_PORT=8790
VOICE_API_SECRET=your-long-random-secret
# API_HOST=127.0.0.1
# VOICE_API_ALLOWED_CASE_IDS=samantha-lewis

STT_MODEL=scribe-v2
LLM_MODEL=gpt-5-mini
TTS_MODEL=eleven-flash-v2.5
TTS_VOICE=alloy

